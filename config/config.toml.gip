[server]
host = "0.0.0.0"
port = 4000
max_connections = 200
max_allowed_packet = 16777216
read_timeout = "30s"
write_timeout = "30s"
idle_timeout = "10m"
shutdown_timeout = "15s"
audit_timeout = "30s"
audit_only = false
# 旁路审核实例设为 true；完整执行实例保持 false。

[auth]
username = "archery"
password = "123456"
# 登录 4000 端口使用的密码。

[log]
level = "info"
format = "text"

[observability]
enabled = false
host = "127.0.0.1"
port = 4001

# 可选；执行 backup=1 前必须正确配置。
[backup]
host = "127.0.0.1"
port = 3306
user = "root"
password = "123456"

[inc]
check_index_column_repeat = true
check_identifier = true
check_identifier_lower = false
enable_identifer_keyword = true
enable_set_charset = true
enable_set_collation = true
enable_set_engine = false
check_primary_key = true
check_table_comment = true
check_column_comment = true
enable_column_charset = false
enable_blob_type = true
enable_json_type = true
max_key_parts = 5
max_primary_key_parts = 3
max_keys = 10
check_autoincrement_datatype = true
check_dml_where = true
max_column_count = 100
max_update_rows = 0
max_insert_rows = 0
check_dml_limit = true
check_dml_orderby = true
check_insert_field = false
check_implicit_type_conversion = true
enable_select_star = false
enable_foreign_key = false
enable_partition_table = true
enable_drop_table = true
enable_drop_database = false
enable_truncate_table = false
required_engine = "innodb"
index_prefix = "idx_"
uniq_index_prefix = "uniq_"
table_prefix = ""
explain_rule = "first"
sql_mode = "TRADITIONAL"
sql_safe_updates = -1
lock_wait_timeout = -1
skip_grant_table = true
support_charset = "utf8mb4"
support_engine = "innodb"
lang = "en-US"
general_log = false
default_charset = "utf8mb4"
must_have_columns = ""
custom_keywords = []
check_column_type_change = true
# 目标文件未显式设置的旧版开关；以下值等同旧 goInception 默认值。
check_index_prefix = false
enable_nullable = true
enable_enum_set_bit = false
enable_timestamp_type = true
enable_autoincrement_unsigned = false
enable_pk_columns_only_int = false
check_timestamp_count = true
max_char_length = 0

# Stable Plus rule levels. See docs/GIP_RULE_CONFIG_GUIDE.md.
# 0=off, 1=Warning, 2=Error.
# When [inc_level] is also present, these GIP RuleIDs take precedence.
[rules]
"GIP-COR-ST-001" = 2
"GIP-COR-PS-001" = 1
"GIP-COR-PS-002" = 2
"GIP-COR-SF-001" = 2
"GIP-META-CN-001" = 2
"GIP-META-CN-002" = 2
